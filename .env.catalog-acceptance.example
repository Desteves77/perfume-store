# Copie para .env.catalog-acceptance e substitua os marcadores localmente.
# O arquivo real e os dados da homologacao sao ignorados pelo Git.
POSTGRES_DB=perfumestore_catalog_acceptance
POSTGRES_USER=catalog_acceptance
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
CATALOG_ACCEPTANCE_POSTGRES_PORT=56000
CATALOG_ACCEPTANCE_SMTP_PORT=11025
CATALOG_ACCEPTANCE_MAILPIT_PORT=18025
SERVER_PORT=18080
SPRING_PROFILES_ACTIVE=local
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:56000/perfumestore_catalog_acceptance
SPRING_DATASOURCE_USERNAME=catalog_acceptance
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_LOCAL_ONLY
MAIL_HOST=127.0.0.1
MAIL_PORT=11025
CATALOG_IMAGE_STORAGE_ROOT=./acceptance-data/catalog-images
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_PASSWORD_RESET_URL=http://localhost:3000/reset-password
