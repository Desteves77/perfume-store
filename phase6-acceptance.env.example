COMPOSE_PROJECT_NAME=perfumestore-phase6
POSTGRES_DB=perfumestore_phase6
POSTGRES_USER=phase6_user
POSTGRES_PASSWORD=change-me-phase6-local-only
PHASE6_POSTGRES_PORT=56200
PHASE6_SMTP_PORT=11225
PHASE6_MAILPIT_PORT=18225

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:56200/perfumestore_phase6
SPRING_DATASOURCE_USERNAME=phase6_user
SPRING_DATASOURCE_PASSWORD=change-me-phase6-local-only
SERVER_PORT=18280
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
CSRF_COOKIE_SECURE=false
CSRF_COOKIE_SAME_SITE=Lax
SESSION_TIMEOUT=30m
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=Lax
MAIL_HOST=localhost
