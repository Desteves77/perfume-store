# Copy this file to .env for local development. Do not use these values in production.
COMPOSE_PROJECT_NAME=perfumestore
POSTGRES_DB=perfumestore
POSTGRES_USER=perfumestore_local
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=54329
BACKEND_PORT=18081
FRONTEND_PORT=3100
FRONTEND_API_URL=http://localhost:18081
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# These variables are consumed by the Java process after they are exported to its environment.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:54329/perfumestore
SPRING_DATASOURCE_USERNAME=perfumestore_local
SPRING_DATASOURCE_PASSWORD=change-me-local-only
SERVER_PORT=18081
CORS_ALLOWED_ORIGINS=http://localhost:3100
CORS_ALLOW_CREDENTIALS=true
CSRF_COOKIE_SECURE=false
CSRF_COOKIE_SAME_SITE=Lax
SESSION_TIMEOUT=30m
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=Lax
CART_COOKIE_SECURE=false
CART_COOKIE_SAME_SITE=Lax
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@perfumestore.local
FRONTEND_PASSWORD_RESET_URL=http://localhost:3100/reset-password
PAYMENT_ENABLED=false
PAYMENT_PROVIDER=
SHIPPING_ENABLED=false
SHIPPING_SYNTHETIC=true
NOTIFICATION_ENABLED=true
NOTIFICATION_DISPATCH_ENABLED=true
ADMIN_PROVISIONING_ENABLED=false
ADMIN_PROVISIONING_NAME=
ADMIN_PROVISIONING_EMAIL=
ADMIN_PROVISIONING_PASSWORD=
